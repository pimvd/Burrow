{
  "sourceLanguage": "en",
  "strings": {
    "%@ was also changed somewhere else while you were editing. Which version should Burrow keep?": {
      "comment": "Conflict dialog explanation",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ wurde während deiner Bearbeitung auch anderswo geändert. Welche Version soll Burrow behalten?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ también se modificó en otro lugar mientras editabas. ¿Qué versión debe conservar Burrow?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ a aussi été modifié ailleurs pendant votre édition. Quelle version Burrow doit-il conserver ?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is ook ergens anders gewijzigd terwijl jij aan het bewerken was. Welke versie moet Burrow bewaren?"
          }
        }
      }
    },
