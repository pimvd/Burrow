    "Add a profile for each child. Every profile has its own tiles, colours and screen time.": {
      "comment": "Empty profile list description",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lege für jedes Kind ein Profil an. Jedes Profil hat eigene Kacheln, Farben und Bildschirmzeit."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea un perfil para cada niño. Cada perfil tiene sus propios mosaicos, colores y tiempo de pantalla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Créez un profil par enfant. Chaque profil a ses propres tuiles, couleurs et temps d’écran."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Maak voor elk kind een profiel. Elk profiel heeft eigen tegels, kleuren en schermtijd."
          }
        }
      }
    },
