    "Burrow keeps usage data until you remove it yourself. Tiles you delete take their own statistics with them after 14 days.": {
      "comment": "Usage cleanup explanation",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Burrow behält Nutzungsdaten, bis du sie selbst löschst. Gelöschte Kacheln nehmen ihre Statistiken nach 14 Tagen mit."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Burrow conserva los datos de uso hasta que los borres. Los mosaicos eliminados se llevan sus estadísticas tras 14 días."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Burrow conserve les données d’utilisation jusqu’à ce que vous les effaciez. Les tuiles supprimées emportent leurs statistiques après 14 jours."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Burrow bewaart gebruiksgegevens tot je ze zelf wist. Tegels die je verwijdert nemen na 14 dagen hun eigen statistieken mee."
          }
        }
      }
    },
