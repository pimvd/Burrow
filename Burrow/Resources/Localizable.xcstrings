    "The file is copied into Burrow, so it keeps playing without an internet connection.": {
      "comment": "Local file explanation",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Datei wird in Burrow kopiert und spielt so auch ohne Internet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El archivo se copia en Burrow, así se reproduce sin conexión a Internet."
          }
        },
        "fr": {
          "stringUnit": {
