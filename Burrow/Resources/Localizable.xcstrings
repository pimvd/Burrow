    "YouTube link": {
      "comment": "YouTube link field",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "YouTube-Link"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
