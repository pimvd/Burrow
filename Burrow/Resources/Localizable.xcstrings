    },
    "The type is set when the tile is created and cannot be changed later. To switch, delete this tile and make a new one.": {
      "comment": "Tile category is permanent",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Typ wird beim Anlegen der Kachel festgelegt und lässt sich später nicht ändern. Zum Wechseln lösche diese Kachel und erstelle eine neue."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El tipo se fija al crear el mosaico y no se puede cambiar después. Para cambiarlo, elimina este mosaico y crea uno nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le type est fixé à la création de la tuile et ne peut plus changer. Pour en changer, supprimez cette tuile et créez-en une nouvelle."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het type ligt vast zodra de tegel is gemaakt en kan later niet veranderen. Wil je wisselen, verwijder deze tegel dan en maak een nieuwe."
          }
        }
      }
    },
