    "The free version holds three items per playlist. Unlock Burrow for up to 50.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die kostenlose Version fasst drei Einträge pro Wiedergabeliste. Schalte Burrow frei für bis zu 50."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La versión gratuita permite tres elementos por lista. Desbloquea Burrow para hasta 50."
          }
        },
        "fr": {
