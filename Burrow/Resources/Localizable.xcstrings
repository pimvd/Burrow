    "The tiles of this profile move to the trash and can be restored for 14 days.": {
      "comment": "Profile deletion explanation",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Kacheln dieses Profils wandern in den Papierkorb und lassen sich 14 Tage lang wiederherstellen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los mosaicos de este perfil van a la papelera y pueden restaurarse durante 14 días."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les tuiles de ce profil vont à la corbeille et peuvent être restaurées pendant 14 jours."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De tegels van dit profiel gaan naar de prullenbak en zijn 14 dagen terug te zetten."
          }
        }
      }
    },
    "The tiles, their files and their statistics are removed for good.": {
      "comment": "Empty trash explanation",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Kacheln, ihre Dateien und ihre Statistiken werden endgültig entfernt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los mosaicos, sus archivos y sus estadísticas se eliminan definitivamente."
          }
        },
