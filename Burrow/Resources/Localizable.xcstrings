    "This backup holds %lld profiles and %lld tiles. Merging adds what is missing; replacing removes everything that is here now.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Backup enthält %1$lld Profile und %2$lld Kacheln. Zusammenführen ergänzt Fehlendes; Ersetzen entfernt alles Vorhandene."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta copia contiene %1$lld perfiles y %2$lld mosaicos. Fusionar añade lo que falta; reemplazar elimina todo lo que hay ahora."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette sauvegarde contient %1$lld profils et %2$lld tuiles. La fusion ajoute ce qui manque ; le remplacement supprime tout ce qui est présent."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze back-up bevat %1$lld profielen en %2$lld tegels. Samenvoegen voegt toe wat ontbreekt; vervangen verwijdert alles wat er nu staat."
          }
        }
      }
